# Copy to /etc/aster/api.env with owner root:aster and mode 0640.
# Replace the example origin; provide secret files separately. Do not put secrets here.
APP_MODE=production
APP_ORIGIN=https://billing.example.com
LISTEN_ADDR=127.0.0.1:18080
TRUSTED_PROXY_CIDRS=127.0.0.1/32
SESSION_SECRET_FILE=/etc/aster/secrets/session_secret
MYSQL_DSN_FILE=/etc/aster/secrets/mysql_runtime_dsn
MYSQL_ALLOW_INSECURE=false
PAYMENT_PROVIDER=payment.disabled
EMAIL_PROVIDER=email.disabled
