{
  "name": "aster-cloud-console",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host localhost",
    "test": "vitest run && node --test tests/data-layer.mjs",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "5.0.4",
    "vue-tsc": "^3.0.8"
  }
}
